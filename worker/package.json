{
  "name": "workhours-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute workhours --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute workhours --remote --file=./schema.sql",
    "db:migrate": "wrangler d1 execute workhours --file=./migrations/0001_add_notes.sql",
    "db:migrate:remote": "wrangler d1 execute workhours --remote --file=./migrations/0001_add_notes.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.5.2",
    "wrangler": "^3.91.0"
  }
}
